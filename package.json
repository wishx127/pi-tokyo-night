{
  "name": "@wishx127/pi-tokyo-night",
  "version": "1.1.0",
  "description": "Pi theme + extension bringing Tokyo Night color scheme with a Powerline-style status bar",
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.79.0",
    "@earendil-works/pi-coding-agent": ">=0.79.0",
    "@earendil-works/pi-tui": ">=0.79.0"
  },
  "keywords": [
    "pi",
    "pi-package",
    "theme",
    "extension",
    "tokyo-night",
    "status-bar"
  ],
  "pi": {
    "themes": [
      "./themes/tokyo-night-dark.json",
      "./themes/tokyo-night-light.json"
    ],
    "extensions": [
      "./extensions/pi-tokyo-night"
    ],
    "image": "https://raw.githubusercontent.com/wishx127/pi-tokyo-night/main/assets/thumbnail.png"
  },
  "author": "wishxhuang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wishx127/pi-tokyo-night.git"
  },
  "files": [
    "themes/**/*",
    "extensions/**/*.ts",
    "!extensions/**/*.test.ts",
    "README.md",
    "assets/**/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "vitest run && tsc --noEmit",
    "compatibility": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
