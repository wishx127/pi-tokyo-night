{
  "name": "@wishx127/pi-tokyo-night",
  "version": "1.1.6",
  "description": "Animated Tokyo Night theme + extension for Pi with dynamic rain, a Powerline status bar, switchable light/dark themes, and live settings.",
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-theme",
    "pi-extension",
    "theme",
    "terminal-theme",
    "tui",
    "tokyo-night",
    "animated",
    "rain",
    "powerline",
    "status-bar",
    "dark-theme",
    "light-theme"
  ],
  "pi": {
    "themes": [
      "./themes/tokyo-night-dark.json",
      "./themes/tokyo-night-light.json"
    ],
    "extensions": [
      "./extensions/pi-tokyo-night"
    ],
    "video": "https://raw.githubusercontent.com/wishx127/pi-tokyo-night/main/assets/showcase.mp4",
    "image": "https://raw.githubusercontent.com/wishx127/pi-tokyo-night/main/assets/thumbnail.png"
  },
  "author": "wishxhuang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wishx127/pi-tokyo-night.git"
  },
  "files": [
    "themes/**/*",
    "extensions/**/*.ts",
    "!extensions/**/*.test.ts",
    "!extensions/**/*.spec.ts",
    "README.md",
    "README.zh-CN.md",
    "assets/screenshot.png"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:check": "node scripts/package-contract.mjs",
    "check": "vitest run && tsc --noEmit && npm run package:check",
    "compatibility": "npm run check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
